NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon branches named dev, test, and bench. Each must be a different host.
# `bun run db:migrate` requires the *direct* string (Connection pooling toggle OFF;
# hostname must not contain "-pooler"). The app can use either string.
# Use `bun run test` / `bun run test:db`; plain `bun test` is Bun's own runner.
DATABASE_URL=
DATABASE_URL_TEST=
DATABASE_URL_BENCH=

# Your Clerk user id (Clerk dashboard → Users). Seed deletes only this user's manual rows.
SEED_USER_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Plaid routes and the Connect UI are off unless this is exactly "true".
# Bank sync is future work; leave unset for the portfolio deploy.
ENABLE_PLAID=
PLAID_CLIENT_TOKEN=
PLAID_SECRET_TOKEN=

# /api/subscriptions (LemonSqueezy checkout + webhook) is off unless this is exactly "true".
# The paywall is off and no UI calls it; leave unset for the portfolio deploy.
ENABLE_SUBSCRIPTIONS=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=